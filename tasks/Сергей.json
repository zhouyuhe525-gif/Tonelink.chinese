    "read": [],
    "speak": [
        {
            "type": "翻译题",
            "content": "Рядом с нашим домом нет цветочного магазина.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Я помню, что тот магазин где-то здесь поблизости.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Я внизу, у вашей компании, ты меня видишь?",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Наши соседи сверху очень шумные.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Лифт сломался, я не могу на нём подняться наверх.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Мусорное ведро полнено, я спущусь вниз выбросить мусор.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Я часто ношу чёрную одежду.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Стало холодно, тебе нужно теплее(больше) одеваться.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Одна вещь одежды, эта вещь(одежды)",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Сегодня на улице сильный ветер, тебе лучше надеть две свитера",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Харбин находится на севере Китая.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Люди на севере больше любят есть лапшу и хлеб.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "На юге Китая даже зимой листья зелёные.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Южане обычно ниже ростом, а северяне выше.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "В Китае нельзя использовать оружие.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "У нас дома есть несколько игрушечных пистолетов, все они для кота.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "В последнее время я слишком занят, у меня нет сил на другие дела.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Кот поспал пять минут и сразу снова полон энергии.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Я рекомендую тебе примерить эту одежду.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Я рекомендую сесть на это место, отсюда видно пейзаж за окном.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Они рекомендовали мне использовать это приложение.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Моё здоровье восстановилось, я снова могу заниматься спортом.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Мой компьютер починили, теперь можно выходить в интернет.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "В это блюдо, кроме картошки, нужно ещё добавить грибы и лук.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Приложение «Meituan» кроме заказа еды с доставкой, ещё позволяет покупать билеты в кино и вызывать такси.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Он, кроме курения, во всём остальном хороший человек.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Тратить деньги, тратить время.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Так делать неэффективно, потратишь много времени.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "В этом месяце наша семья потратила много денег.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Мы решили остаться дома встречать Новый год.",
            "ref": "",
            "raw_type": "翻译题"
        },
        {
            "type": "翻译题",
            "content": "Он решил получить водительские права следующим летом.",
            "ref": "",
            "raw_type": "翻译题"
        }
    ],
